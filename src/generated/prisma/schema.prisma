generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  phone    String?
  role     Role    @default(USER)

  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?

  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  customer Customer?

  movements      Movement[]
  purchaseOrders Order[]
  saleOrders     SaleOrder[] @relation("SaleOrderCustomer")
  soldOrders     SaleOrder[] @relation("SaleOrderSeller")
  receipts       Receipt[]
  auditLogs      AuditLog[]

  @@index([status])
  @@map("users")
}

enum Role {
  ADMIN // Acceso total
  USER // Solicitar pedidos, ver historial
  WAREHOUSE // Gestionar inventario, recibir pedidos
  SELLER // Vender, crear pedidos de venta
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================
// CUSTOMERS (Para ventas minorista/mayorista)
// ============================================

model Customer {
  id           String       @id @default(cuid())
  name         String
  email        String?      @unique
  phone        String?
  document     String?
  customerType CustomerType @default(RETAIL)

  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  saleOrders SaleOrder[]

  @@index([status])
  @@map("customers")
}

enum CustomerType {
  RETAIL // Minorista
  WHOLESALE // Mayorista
}

// ============================================
// INVENTORY CONFIGURATION
// ============================================

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?

  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]

  @@index([status])
  @@map("categories")
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  contact String?
  email   String?
  phone   String?
  address String?

  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]
  orders   Order[] // Purchase orders

  @@index([status])
  @@map("suppliers")
}

model UnitOfMeasure {
  id     String  @id @default(cuid())
  name   String  @unique
  symbol String?

  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]

  @@index([status])
  @@map("units_of_measure")
}

// ============================================
// PRODUCTS & PRICING TIERS
// ============================================

model Product {
  id            String  @id @default(cuid())
  code          String  @unique // 🔲 Código de barras / SKU
  name          String
  description   String?
  image         String? // URL de la imagen principal
  purchasePrice Decimal @db.Decimal(10, 2)

  // Precios base
  retailPrice          Decimal  @db.Decimal(10, 2) // Precio minorista (1 unidad)
  wholesalePrice       Decimal? @db.Decimal(10, 2) // Precio mayorista (aplica si quantity >= wholesaleMinQuantity)
  wholesaleMinQuantity Int      @default(10) // Cantidad mínima para precio mayorista

  // Límites de venta
  minSalePrice Decimal? @db.Decimal(10, 2)
  maxSalePrice Decimal? @db.Decimal(10, 2)

  // Stock
  minStock      Int @default(0)
  currentStock  Int @default(0)
  reservedStock Int @default(0) // Stock reservado en pedidos pendientes

  hasVariants Boolean @default(false)

  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relaciones
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  unitId String
  unit   UnitOfMeasure @relation(fields: [unitId], references: [id])

  variants ProductVariant[]

  movements            Movement[]
  purchaseOrderDetails OrderDetail[]
  saleOrderDetails     SaleOrderDetail[]

  recommendationsFrom ProductRecommendation[] @relation("ProductRecommendationsFrom")
  recommendationsTo   ProductRecommendation[] @relation("ProductRecommendationsTo")

  @@index([status])
  @@index([code]) // 🔲 Índice para búsqueda rápida por código de barras
  @@index([categoryId])
  @@index([supplierId])
  @@index([hasVariants])
  @@map("products")
}

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  color String?
  size  String?

  sku         String?  @unique
  retailPrice Decimal? @db.Decimal(10, 2)

  currentStock  Int @default(0)
  reservedStock Int @default(0)

  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([productId, color, size])
  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

model ProductRecommendation {
  id                   String   @id @default(cuid())
  productId            String
  recommendedProductId String
  priority             Int      @default(0)
  createdAt            DateTime @default(now())

  product            Product @relation("ProductRecommendationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  recommendedProduct Product @relation("ProductRecommendationsTo", fields: [recommendedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, recommendedProductId])
  @@index([productId])
  @@index([recommendedProductId])
  @@map("product_recommendations")
}

// ============================================
// MOVEMENTS (AUDITORÍA DE INVENTARIO)
// ============================================

model Movement {
  id          String       @id @default(cuid())
  type        MovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reason      String?
  unitPrice   Decimal?     @db.Decimal(10, 2)
  reference   String? // ID de orden, factura, etc.
  createdAt   DateTime     @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("movements")
}

enum MovementType {
  IN // Entrada por compra
  OUT // Salida por venta
  ADJUSTMENT // Ajuste manual
  RETURN // Devolución
  RESERVE // Reservar stock para pedido
  RELEASE // Liberar stock reservado
}

// ============================================
// PURCHASE ORDERS (Pedidos a Proveedores)
// ============================================

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique // Ej: PO-2026-00123
  status               OrderStatus @default(PENDING)
  total                Decimal     @default(0) @db.Decimal(12, 2)
  orderDate            DateTime    @default(now())
  expectedDeliveryDate DateTime?
  receivedDate         DateTime?
  observations         String?
  createdAt            DateTime    @default(now())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  userId String // Usuario que creó el pedido
  user   User   @relation(fields: [userId], references: [id])

  details  OrderDetail[]
  receipts Receipt[] // Comprobantes de pago/facturas

  @@map("orders")
}

enum OrderStatus {
  DRAFT // Borrador
  PENDING // Enviado a aprobación
  APPROVED // Aprobado por admin
  RECEIVED // Recibido en almacén (stock actualizado)
  CANCELLED // Cancelado
}

model OrderDetail {
  id       String  @id @default(cuid())
  quantity Int
  price    Decimal @db.Decimal(10, 2) // Precio de compra unitario
  subtotal Decimal @db.Decimal(12, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_details")
}

// ============================================
// SALE ORDERS (Pedidos de Clientes - Ventas)
// ============================================

model SaleOrder {
  id          String          @id @default(cuid())
  orderNumber String          @unique // Ej: SO-2026-00123
  status      SaleOrderStatus @default(PENDING_REQUEST)

  // Tipo de cliente y precios aplicados
  customerType   CustomerType
  pricingApplied PricingType // RETAIL o WHOLESALE (calculado al crear)

  total         Decimal   @default(0) @db.Decimal(12, 2)
  orderDate     DateTime  @default(now())
  deliveryDate  DateTime?
  completedDate DateTime?
  observations  String?
  createdAt     DateTime  @default(now())

  // Cliente (puede ser User registrado o Customer externo)
  userId String?
  user   User?   @relation("SaleOrderCustomer", fields: [userId], references: [id])

  customerId String? // Si es cliente externo
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Vendedor asignado
  // ✅ Vendedor (quien atiende el pedido) - Relación nombrada
  sellerId String?
  seller   User?   @relation("SaleOrderSeller", fields: [sellerId], references: [id])

  details   SaleOrderDetail[]
  receipts  Receipt[] // Comprobantes de pago (fotos)
  auditLogs AuditLog[]

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@map("sale_orders")
}

enum SaleOrderStatus {
  PENDING_REQUEST // 🟡 Usuario solicitó (espera aprobación)
  APPROVED // 🟢 Admin aprobó (reserva stock)
  PREPARING // 📦 En preparación
  READY // ✅ Listo para retirar/enviar
  COMPLETED // 🎉 Entregado y finalizado
  CANCELLED // ❌ Cancelado por usuario o admin
  REJECTED // ⛔ Rechazado por admin (sin stock, etc.)
}

enum PricingType {
  RETAIL // Precio minorista
  WHOLESALE // Precio mayorista (aplica por cantidad)
}

model SaleOrderDetail {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) // Precio aplicado (retail/wholesale)
  subtotal  Decimal @db.Decimal(12, 2)

  // Para auditoría: precios originales del producto
  productSnapshot Json? // Copia del producto al momento de la venta

  orderId String
  order   SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@map("sale_order_details")
}

// ============================================
// RECEIPTS / COMPROBANTES (FOTOS)
// ============================================

model Receipt {
  id         String      @id @default(cuid())
  type       ReceiptType
  fileUrl    String // URL o path en storage (S3, Cloudinary, local)
  fileName   String
  fileSize   Int // En bytes
  mimeType   String
  uploadedAt DateTime    @default(now())

  // 🔒 Validación para evitar llenar la BD
  deleted        Boolean   @default(false) // Soft delete
  deletedAt      DateTime?
  deletionReason String? // Motivo de eliminación (auditoría)
  autoDeleteAt   DateTime? // Fecha programada para eliminación automática

  // Relaciones polimórficas simplificadas
  orderId String? // Para purchase orders
  order   Order?  @relation(fields: [orderId], references: [id])

  saleOrderId String? // Para sale orders
  saleOrder   SaleOrder? @relation(fields: [saleOrderId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([orderId])
  @@index([saleOrderId])
  @@index([deleted])
  @@map("receipts")
}

enum ReceiptType {
  INVOICE // Factura de compra
  PAYMENT_PROOF // Comprobante de pago (foto)
  DELIVERY_PROOF // Foto de entrega
  OTHER
}

// ============================================
// AUDIT LOG / HISTORIAL
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  action     String // CREATE, UPDATE, DELETE, APPROVE, CANCEL
  entityType String // "SaleOrder", "Product", etc.
  entityId   String // ID del registro afectado
  changes    Json? // { before: {}, after: {} }
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Relación opcional con SaleOrder para historial específico
  saleOrderId String?
  saleOrder   SaleOrder? @relation(fields: [saleOrderId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// MIDDLEWARE CONFIG (Opcional para rutas)
// ============================================

model RoutePermission {
  id     String @id @default(cuid())
  route  String @unique // Ej: "/dashboard/orders/approve"
  method String @default("GET") // GET, POST, PUT, DELETE
  roles  Role[] // Roles permitidos

  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@map("route_permissions")
}
